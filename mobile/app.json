{
  "expo": {
    "name": "BeraberGidelim",
    "slug": "berabergidelim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "berabergidelim",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020617",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.berabergidelim.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki etkinlikleri göstermek için konumuna ihtiyacımız var.",
        "NSMicrophoneUsageDescription": "Sesli mesaj için mikrofon gerekli."
      }
    },
    "android": {
      "package": "com.berabergidelim.app",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
